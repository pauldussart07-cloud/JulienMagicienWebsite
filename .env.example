# Envoi du formulaire de devis (https://resend.com)
#
# Seule RESEND_API_KEY est indispensable. Sans elle, le formulaire affiche
# un message invitant à écrire directement à Julien, et rien ne part.
RESEND_API_KEY=

# Expéditeur. Laissé vide, le site utilise onboarding@resend.dev, l'adresse
# que Resend ouvre à tout compte sans vérification de domaine : elle n'écrit
# qu'au titulaire du compte, ce qui suffit puisque les demandes arrivent chez
# Julien. Une fois julienlambertmagicien.fr vérifié dans Resend, renseigner
# une adresse du domaine : le message cesse d'arriver au nom de Resend.
CONTACT_FROM=

# Destinataire des demandes de devis. Par défaut, l'adresse de Julien.
CONTACT_TO=julienlambertmagicien@gmail.com
